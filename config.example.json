{
  "protocol": "full-candidate-v1",
  "evolution": {"max_rounds": 20},
  "solver": {"max_steps": 11, "max_service_calls": 64, "max_frames": 256, "timeout_seconds": 1800},
  "execution": {"concurrency": 16, "linux_isolation": true, "python": "SET_ABSOLUTE_PYTHON_PATH"},
  "services": {
    "endpoint_env": "API_BASE", "key_env": "API_KEY",
    "deepseek": {"request_model": "deepseek-v4-pro", "max_tokens": 8192},
    "qwen": {"request_model": "qwen3.6-plus", "max_tokens": 8192},
    "temperature": 0, "timeout_seconds": 240, "provider_retries": 1,
    "ffmpeg": "imageio-ffmpeg", "ocr_model_root": "SET_LOCAL_OCR_MODEL_DIRECTORY"
  },
  "editor": {
    "max_provider_calls": 160, "timeout_seconds": 3600, "pause_after_plan": false,
    "harness_root": "SET_DEEPSEEK_HARNESS_DIRECTORY", "node_binary": "SET_ABSOLUTE_NODE_PATH"
  },
  "investigation": {"max_frames": 1024},
  "gate": {"policy": "accuracy_gain_10pct_or_save_20pct_drop1_v1", "max_mean_frames": null}
}
