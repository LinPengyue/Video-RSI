+/**
+ * Repair provider histories where a streamed tool call omitted its id. The
+ * harness durably records that omission on both the assistant call and its
+ * following result; replaying the empty id makes OpenAI-compatible gateways
+ * reject every later request. Preserve provider ids when present and recover
+ * only missing ids, pairing results with outstanding calls in wire order.
+ */
+function normalizeToolCallIds(messages: readonly Message[]): Message[] {
+  const pending: ReturnType<typeof CallId>[] = []
+  return messages.map((message, messageIndex) => {
+    if (message.role === 'assistant') {
+      const content = message.content.map((block, blockIndex) => {
+        if (block.type !== 'tool-call') return block
+        const id = String(block.id).length > 0
+          ? block.id
+          : CallId(`call_dsh_recovered_${messageIndex}_${blockIndex}`)
+        pending.push(id)
+        return id === block.id ? block : { ...block, id }
+      })
+      return { ...message, content }
+    }
+
+    const content = message.content.map((block) => {
+      if (block.type !== 'tool-result') return block
+      if (String(block.toolCallId).length > 0) {
+        const matched = pending.findIndex(id => id === block.toolCallId)
+        if (matched >= 0) pending.splice(matched, 1)
+        return block
+      }
+      const recovered = pending.shift()
+      if (recovered === undefined) {
+        throw new LlmError(
+          'DeepSeek history contains an empty tool_call_id without a matching assistant tool call.',
+          'INVALID_REQUEST',
+        )
+      }
+      return { ...block, toolCallId: recovered }
+    })
+    return { ...message, content }
+  })
+}
