+/** Recover a gateway-erased tool name only when one request schema matches exactly. */
+export function recoverEmptyToolName(argumentsText: string, tools: readonly WireTool[]): string {
+  let value: unknown
+  try {
+    value = JSON.parse(argumentsText)
+  } catch {
+    throw new LlmError('blank-name tool call has malformed arguments', 'TOOL_IDENTITY_UNVERIFIED')
+  }
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) {
+    throw new LlmError('blank-name tool call arguments are not an object', 'TOOL_IDENTITY_UNVERIFIED')
+  }
+  const keys = Object.keys(value)
+  const matches = tools.filter((tool) => {
+    const schema = tool.function.parameters
+    const properties = schema.properties
+    if (properties === null || typeof properties !== 'object' || Array.isArray(properties)) return false
+    const allowed = new Set(Object.keys(properties))
+    const required = Array.isArray(schema.required)
+      ? schema.required.filter((item): item is string => typeof item === 'string')
+      : []
+    return required.every(key => Object.hasOwn(value as object, key))
+      && keys.every(key => allowed.has(key))
+  })
+  if (matches.length !== 1) {
+    throw new LlmError(
+      `blank-name tool call matched ${matches.length} request schemas`,
+      'TOOL_IDENTITY_UNVERIFIED',
+    )
+  }
+  return matches[0]!.function.name
+}
